{
  "description": "Bash をテキストエディタ代わりに使うコマンド（sed -i 単一ファイル / リダイレクト / tee / インライン python 等）を検知し Edit・Write ツールへ誘導する",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_context.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
