<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>MyGame</RootNamespace>
    <!-- iOS/NativeAOT: the Godot export doesn't bundle icudt.dat, so ICU init
         crashes at startup. Use CultureInfo.InvariantCulture explicitly. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- .gdignore only hides lib/ and tools/ from the editor's filesystem scan;
       the SDK's default **/*.cs glob would still compile them in here. -->
  <ItemGroup>
    <Compile Remove="lib/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="lib/MyGame.Core/MyGame.Core.csproj" />
    <!-- <ProjectReference Include="lib/MyGame.Native/MyGame.Native.csproj" /> -->
  </ItemGroup>
</Project>
